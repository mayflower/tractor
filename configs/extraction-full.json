{
  "output_dir": "runs/extraction-full",
  "experiment_name": "extraction-full",
  "num_epochs": 2,
  "max_steps": -1,
  "batch_size": 8,
  "eval_batch_size": 8,
  "gradient_accumulation_steps": 4,
  "encoder_lr": 5e-06,
  "task_lr": 0.0001,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "scheduler_type": "cosine",
  "warmup_ratio": 0.1,
  "fp16": false,
  "bf16": true,
  "eval_strategy": "epoch",
  "save_best": true,
  "save_total_limit": 1,
  "metric_for_best": "eval_pipeline_selection_score",
  "greater_is_better": true,
  "logging_steps": 10,
  "report_to_wandb": false,
  "seed": 42,
  "num_workers": 0,
  "pin_memory": true,
  "validate_data": true,
  "strict_training": true,
  "ignore_nonfinite_losses": false,
  "skip_step_errors": false,
  "allow_invalid_samples": false,
  "on_capacity_exceeded": "raise",
  "use_lora": false,
  "compile_model": false,
  "gradient_checkpointing": false,
  "tractor_extraction_dev": "data/my-qualified-corpus/dev.episodes.jsonl",
  "tractor_quality_policy": "configs/extraction-quality.json",
  "tractor_required_groups": [
    "encoder",
    "boundary_head",
    "record_decoder"
  ],
  "tractor_max_seconds": 28800
}
